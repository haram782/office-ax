# Office-AX 로컬 CLI QA 환경변수 템플릿
# cp .env.local-beta.example .env.local-beta 후 secret, DB 비밀번호, Google client ID, ngrok 고정 도메인을 입력한다.

DJANGO_SECRET_KEY=replace-with-long-random-secret
DEBUG=False
ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,localhost,backend-web
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DB_NAME=officeax_local_beta
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
BETA_DB_PASSWORD=replace-with-db-password

BETA_HTTP_PORT=8080
BETA_RELEASE_TAG=local-beta
BETA_ACCESS_MODE=open
BETA_ALLOWED_EMAILS=
BETA_MONTHLY_CREDITS=30

LLM_PROVIDER=claude_cli
CLAUDE_CLI_TIMEOUT=180
CLAUDE_CLI_MODEL=claude-cli

VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# ngrok 무료 계정 dev domain (https://dashboard.ngrok.com/domains) — 고정이라
# 재시작해도 바뀌지 않는다. ngrok config add-authtoken <token> 선행 필요.
NGROK_DOMAIN=replace-with-ngrok-static-domain.ngrok-free.app

BETA_LOG_MAX_SIZE=10m
BETA_LOG_MAX_FILES=3
LOCAL_BETA_REDIS_PORT=6380
