# ── Django ───────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────
DB_NAME=officeax
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# ── Redis (Celery 브로커 + 결과 백엔드) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── 카카오 알림톡 (Solapi) ────────────────────────────────
# 1. https://solapi.com 에서 API Key/Secret 발급
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
# 2. 솔라피에 등록한 발신번호 (카카오 채널 대표 번호와 동일해야 함)
SOLAPI_FROM_NUMBER=0212345678
# 3. 카카오 채널 플러스친구 ID (KA01PF...)
KAKAO_SENDER_PF_ID=KA01PFxxxxxxxxxxxxxxxx
# 4. 사전 승인된 알림톡 템플릿 ID (KA01TP...)
KAKAO_TEMPLATE_ID=KA01TPxxxxxxxxxxxxxxxx

# ── 인바운드 이메일 웹훅 보안 ─────────────────────────────
# SendGrid Inbound Parse URL에 ?token=<이 값> 을 붙여서 등록
# 예: https://api.yourdomain.com/api/v1/inbound-email/?token=s3cr3t
INBOUND_WEBHOOK_SECRET=your-random-secret-token
