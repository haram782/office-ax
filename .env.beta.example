# Office-AX 클로즈드 베타 환경변수 템플릿
# 사용법: cp .env.beta.example .env.beta 후 실제 값 기입 (.env.beta는 커밋 금지)

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# ngrok 고정 도메인 + 내부 접근 호스트
ALLOWED_HOSTS=officeax.ngrok-free.app,localhost,backend-web
# https 프록시(ngrok) 뒤 admin 로그인 CSRF 허용 origin
CSRF_TRUSTED_ORIGINS=https://officeax.ngrok-free.app

# ── DB / Redis (compose 내부 호스트명 기준) ──────────────────────────────
# 주의: env_file은 변수 보간을 하지 않는다 — DB_PASSWORD와 BETA_DB_PASSWORD에
# 반드시 같은 값을 직접 기입할 것
DB_NAME=officeax_beta
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0

# compose 변수 (postgres 컨테이너·호스트 포트)
BETA_DB_PASSWORD=change-me
BETA_HTTP_PORT=8080

# ── 베타 게이트 (M1) ─────────────────────────────────────────────────────
# 초대자 이메일 콤마 목록 — 비우면 전체 허용(개발용)이므로 베타에선 반드시 설정
BETA_ALLOWED_EMAILS=friend1@gmail.com,friend2@gmail.com
# 월간 크레딧 한도 (0 이하 = 무제한)
BETA_MONTHLY_CREDITS=200

# ── LLM (품질 우선 단일 provider — M4에서 모델 확정) ────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 프론트 빌드 타임 (nginx 이미지 빌드 인자) ────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
