# Office-AX 클로즈드 베타 환경변수 템플릿
# 사용법: cp .env.beta.example .env.beta 후 실제 값 기입 (.env.beta는 커밋 금지)

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-long-random-secret
DEBUG=False
ALLOWED_HOSTS=beta.example.invalid,localhost,backend-web
CSRF_TRUSTED_ORIGINS=https://beta.example.invalid
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 실제 HTTPS smoke 전에는 낮게 시작하고 includeSubDomains/preload를 켜지 않는다.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
HEALTHCHECK_TIMEOUT_SECONDS=2

# ── DB / Redis (compose 내부 호스트명 기준) ──────────────────────────────
# 주의: env_file은 변수 보간을 하지 않는다 — DB_PASSWORD와 BETA_DB_PASSWORD에
# 반드시 같은 값을 직접 기입할 것
DB_NAME=officeax_beta
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=postgres
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=3
REDIS_URL=redis://redis:6379/0

# compose 변수 (postgres 컨테이너·호스트 포트)
BETA_DB_PASSWORD=replace-with-db-password
BETA_HTTP_PORT=8080
BETA_RELEASE_TAG=replace-with-git-sha

# ── 베타 게이트 (M1) ─────────────────────────────────────────────────────
# 운영 베타는 allowlist, 로컬 QA 전체 허용은 open을 사용한다.
BETA_ACCESS_MODE=allowlist
# 초대자 이메일 콤마 목록
BETA_ALLOWED_EMAILS=friend1@gmail.com,friend2@gmail.com
# 월간 크레딧 한도 (0 이하 = 무제한)
BETA_MONTHLY_CREDITS=200

# ── LLM (품질 우선 단일 provider — M4에서 모델 확정) ────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 프론트 빌드 타임 (nginx 이미지 빌드 인자) ────────────────────────────
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# ── Compose resource/log boundary ────────────────────────────────────────
BETA_POSTGRES_MEMORY=768m
BETA_POSTGRES_CPUS=1.0
BETA_REDIS_MEMORY=256m
BETA_REDIS_CPUS=0.5
BETA_BACKEND_WEB_MEMORY=1536m
BETA_BACKEND_WEB_CPUS=1.5
BETA_BACKEND_WORKER_MEMORY=3g
BETA_BACKEND_WORKER_CPUS=2.0
BETA_BACKEND_BEAT_MEMORY=384m
BETA_BACKEND_BEAT_CPUS=0.5
BETA_AX_WORKER_MEMORY=4g
BETA_AX_WORKER_CPUS=2.0
BETA_NGINX_MEMORY=256m
BETA_NGINX_CPUS=0.5
BETA_LOG_MAX_SIZE=10m
BETA_LOG_MAX_FILES=5
BETA_MIN_FREE_DISK_KB=10485760
BETA_BACKUP_DIR=/absolute/path/to/officeax-beta-backups
