# ───────────────────────────────────────────────
# LLM 공급자 설정
# ───────────────────────────────────────────────
# 사용할 LLM 공급자를 선택하세요: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (LLM_PROVIDER=openai 시 필수)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (LLM_PROVIDER=anthropic 시 필수)
# Anthropic API는 기본적으로 학습에 사용하지 않음 (ZDR 정책 기본 적용)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ───────────────────────────────────────────────
# Redis (Celery 브로커 + 결과 백엔드)
# ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────────────────────
# 파일 저장 경로 (Django media/ 와 공유)
# ───────────────────────────────────────────────
# AI 교정 결과 아티팩트 (.xlsx 등)
ARTIFACT_DIR=/path/to/backend/media/artifacts

# PPTX 슬라이드 PNG 이미지 (LibreOffice 변환 결과)
SLIDE_DIR=/path/to/backend/media/slides

# ───────────────────────────────────────────────
# LibreOffice (PPTX → PNG 슬라이드 렌더링)
# ───────────────────────────────────────────────
# 미설정 시 PATH에서 자동 탐색 → macOS 앱 번들 경로 순으로 폴백
# macOS:  brew install --cask libreoffice
# Ubuntu: apt install libreoffice
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
